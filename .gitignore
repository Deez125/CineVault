# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
/build

# reference material from the previous build. Read-only, never edited, and deleted
# once the rebuild is done. It contains the old .env files, so it must never be committed.
/REF

# env files. The Stripe secret, the session secret, and the Plex owner token all live here.
.env
.env.*
!.env.example

# Filled-in environment files for pasting into a host's dashboard. These hold REAL
# credentials, and they are named without a leading dot — which means the .env rules above do
# NOT catch them. Spelled out individually rather than trusted to a pattern.
*.env.txt
env.txt
coolify.env
coolify.env.txt

# Session handoff notes. Deliberately NOT committed: this repository is public, and the
# handoff records operational state — what is not yet enforced, what has no backups, which
# file holds the live keys. None of it is a credential and all of it is a map. It travels
# with the project folder instead.
CLAUDE-HANDOFF.md

# database dumps
*.db
*.db-shm
*.db-wal
*.sql.gz
/backups


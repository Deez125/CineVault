# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
/build

# reference material from the previous build. Read-only, never edited, and deleted
# once the rebuild is done. It contains the old .env files, so it must never be committed.
/REF

# env files. The Stripe secret, the session secret, and the Plex owner token all live here.
.env
.env.*
!.env.example


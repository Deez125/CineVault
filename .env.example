# CineVault configuration.
#
# Copy to .env.local and fill in. The app validates all of this at boot (lib/env.ts) and
# refuses to start if something required is missing — a service that boots half-configured
# will take someone's money and then fail to give them anything.

NODE_ENV=development

# Where this app is reachable. Used for Stripe return URLs and links in emails.
APP_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# `docker compose up -d postgres` starts one locally with these credentials.
DATABASE_URL=postgres://cinevault:cinevault_local_dev_only@localhost:5433/cinevault

# ── Secrets ───────────────────────────────────────────────────────────────────
# Any 32+ char random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Stripe ────────────────────────────────────────────────────────────────────
# Both keys must come from the SAME account and the SAME mode (sandbox or live). A
# publishable key from one and a secret from another fails with confusing "no such price"
# errors. Dashboard -> Developers -> API keys.
#
# Test and live mode do NOT share products or prices. Run `npm run stripe:setup` once against
# each mode; it is idempotent and writes the stream count into each price's metadata, so
# there are no per-tier price env vars to keep in sync.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` in development, or the
# endpoint's signing secret in the dashboard. Without this, payments succeed and NOTHING
# HAPPENS: the subscription activates in Stripe and nobody is ever granted access.
STRIPE_WEBHOOK_SECRET=

# ── Plex ──────────────────────────────────────────────────────────────────────
# Get these by running `npm run plex:discover` and signing in as the server owner.
PLEX_TOKEN=
PLEX_MACHINE_ID=

# plex.tv SECTION IDS — not the server's own library keys. They are different numbers and
# passing keys here fails with "404 Not found", as though the server did not exist.
PLEX_LIBRARY_SECTION_IDS=

# A stable UUID identifying this app to Plex. Generate once and never change it.
PLEX_CLIENT_IDENTIFIER=

# Plex usernames that predate this system and must NEVER be touched: no share revocation, no
# stream kills, no exceptions. Comma separated. This is a hard rail, not a preference.
PLEX_PROTECTED_USERS=

# ── Tracearr (stream monitoring) ──────────────────────────────────────────────
TRACEARR_URL=
TRACEARR_API_KEY=

# ── Admin ─────────────────────────────────────────────────────────────────────
# Comma-separated emails granted the admin flag. EMPTY MEANS NOBODY IS AN ADMIN, which is
# deliberate: a misconfigured allowlist should lock the door, not open it.
ADMIN_EMAILS=

# ── Background loops ──────────────────────────────────────────────────────────
RECONCILE_INTERVAL_MS=300000
ENFORCE_INTERVAL_MS=20000
LOG_LEVEL=info
